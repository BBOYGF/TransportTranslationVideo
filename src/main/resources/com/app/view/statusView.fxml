<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.view.StatusView">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <padding>
                <Insets bottom="6.0" left="6.0" right="6.0" top="6.0"/>
            </padding>
            <children>
                <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#onRefreshClick" text="刷新"/>
                <Button fx:id="continueButton" mnemonicParsing="false" onAction="#onContinueClick"
                        text="继续执行未完成步骤"/>
                <Button fx:id="resetAndRunButton" mnemonicParsing="false" onAction="#onResetAndRunClick"
                        text="全部重置并重跑"/>
                <Button fx:id="markDoneButton" mnemonicParsing="false" onAction="#onMarkStepDoneClick"
                        text="步骤标记完成"/>
                <Button fx:id="markUndoneButton" mnemonicParsing="false" onAction="#onMarkStepUndoneClick"
                        text="步骤标记未完成"/>
                <Button fx:id="openFolderButton" mnemonicParsing="false" onAction="#onOpenFolderClick"
                        text="打开文件夹"/>
                <Label fx:id="summaryLabel" text=""/>
            </children>
        </HBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.55">
            <items>
                <TreeTableView fx:id="taskTree">
                    <columns>
                        <TreeTableColumn fx:id="typeCol" prefWidth="110.0" text="类型"/>
                        <TreeTableColumn fx:id="idCol" prefWidth="60.0" text="ID"/>
                        <TreeTableColumn fx:id="titleCol" prefWidth="360.0" text="标题"/>
                        <TreeTableColumn fx:id="progressCol" prefWidth="90.0" text="步骤进度"/>
                        <TreeTableColumn fx:id="artifactCol" prefWidth="90.0" text="产物"/>
                        <TreeTableColumn fx:id="stateCol" prefWidth="90.0" text="状态"/>
                    </columns>
                </TreeTableView>
                <VBox spacing="4.0">
                    <padding>
                        <Insets bottom="6.0" left="6.0" right="6.0" top="6.0"/>
                    </padding>
                    <children>
                        <Label text="① 左边点选任务  →  ② 双击「状态」列直接从下拉框改成已完成/未完成（也可选中后用上方按钮）  →  ③ 点「继续执行未完成步骤」续跑"/>
                        <TableView fx:id="stepTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="stepOrderCol" prefWidth="60.0" text="序号"/>
                                <TableColumn fx:id="stepNameCol" prefWidth="160.0" text="步骤"/>
                                <TableColumn fx:id="stepStateCol" prefWidth="90.0" text="状态"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <TextArea fx:id="logTextArea" editable="false" prefHeight="110.0" wrapText="true"/>
    </bottom>
</BorderPane>
